{
  "name": "chlens",
  "version": "4.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/22-2/chlens.git"
  },
  "scripts": {
    "// --- Base Build Commands ---": "",
    "build": "pnpm build:chrome",
    "build:chrome": "cross-env PLATFORM=chrome ENTRY=browser vp build",
    "build:firefox": "cross-env PLATFORM=firefox ENTRY=browser vp build",
    "build:tauri": "cross-env PLATFORM=tauri ENTRY=browser vp build",
    "build:live": "pnpm --filter chlens-live build",
    "build:all": "run-s build:chrome build:firefox",
    "// --- Development & Watch ---": "",
    "dev:chrome": "cross-env PLATFORM=chrome ENTRY=browser VITE_WATCH_DEV=true vp build --watch --mode development",
    "watch:chrome": "pnpm dev:chrome",
    "watch:tauri": "cross-env PLATFORM=tauri ENTRY=browser VITE_WATCH_DEV=true vp build --watch --mode development",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "dev:live": "pnpm --filter chlens-live dev",
    "ladle": "ladle serve",
    "ladle:build": "ladle build",
    "tauri:live": "pnpm --filter chlens-live tauri:dev",
    "build:tauri-live": "pnpm --filter chlens-live tauri:build",
    "// --- Utility & Lint ---": "",
    "clean": "node -e \"const fs=require('fs-extra'); ['debug/chrome','debug/firefox','debug/tauri'].forEach(d=>fs.removeSync(d))\"",
    "lint": "run-s -c -l lint:oxlint lint:imports lint:format lint:tokens",
    "lint:oxlint": "vp lint --fix src/",
    "lint:imports": "pnpm dlx organize-imports-cli tsconfig.json",
    "lint:format": "vp fmt",
    "lint:tokens": "node scripts/check-browser-design-tokens.mjs",
    "check:live": "pnpm --filter chlens-live check",
    "test": "vp test run",
    "test:live": "pnpm --filter chlens-live test",
    "triage:todo": "node --no-warnings --experimental-strip-types scripts/triage-todo.ts",
    "test:url-commonization": "pnpm vitest run src/content-scripts/url-targets.test.ts src/view/browser/pages/BookmarkListPage.test.tsx && pnpm --filter @chlen/ch-lib exec vitest run src/parser/BoardParser.test.ts src/parser/ThreadParser.test.ts",
    "release": "release-it",
    "release:build": "pnpm build:all && node scripts/package-release.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@rjsf/core": "^6.7.1",
    "@rjsf/utils": "^6.7.1",
    "@rjsf/validator-ajv8": "^6.7.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-sql": "~2",
    "@toon-format/toon": "4.1.0",
    "@types/webextension-polyfill": "^0.12.5",
    "consola": "^3.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "escape-html": "^1.0.3",
    "fuzzysort": "^3.1.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "normalize-wheel": "^1.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "store2": "^2.14.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.0",
    "@release-it/bumper": "^8.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/escape-html": "^1.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/pug": "^2.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "ShortQuery.js": "github:S--Minecraft/ShortQuery.js#1.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "fs-extra": "^11.4.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "jsonc-parser": "^3.3.1",
    "npm-run-all": "^4.1.5",
    "pug": "^3.0.4",
    "release-it": "^21.0.2",
    "sharp": "^0.35.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "webextension-polyfill": "^0.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=25.0"
  }
}
