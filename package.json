  "scripts": {
    "build": "pnpm build:chrome",
    "build:chrome": "cross-env PLATFORM=chrome ENTRY=browser vite build",
    "build:tauri": "cross-env PLATFORM=tauri ENTRY=browser vite build",
    "build:all": "pnpm run build:chrome && pnpm run build:firefox",
    "dev:tauri": "pnpm dlx run-p watch:tauri tauri dev",
    "dev:chrome": "pnpm dlx run-s build:chrome --watch",
    "clean": "node -e \"const fs=require('fs-extra'); Promise.all(['debug/chrome','debug/firefox','debug/tauri'].map(d=>fs.remove(d)))\"",
    "lint": "pnpm dlx run-s -c -l lint:*",
    "lint:eslint": "eslint --cache --fix src/",
    "lint:imports": "pnpm dlx organize-imports-cli tsconfig.json",
    "lint:prettier": "pnpm dlx prettier --editorconfig --write ./src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@rjsf/core": "^6.5.1",
    "@rjsf/utils": "^6.5.1",
    "@rjsf/validator-ajv8": "^6.5.1",
