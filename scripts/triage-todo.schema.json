{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_text": { "type": "string" },
          "action": { "enum": ["create", "append-unclear", "skip"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "duplicate_issue_numbers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          },
          "unclear_questions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reason": { "type": "string" }
        },
        "required": [
          "source_text",
          "action",
          "confidence",
          "title",
          "body",
          "labels",
          "duplicate_issue_numbers",
          "unclear_questions",
          "reason"
        ]
      }
    }
  },
  "required": ["items"]
}
