extends ../_base.pug

block vars
  - var name = "thread";
  - var title = "";
  - var html = {};
  - var htmlClasses = ["view", "view_thread"];
  - var body = {};
  - var needUI = true;
  - var needModule = true;
  - var needCss = true;
  - var needCore = true;

block body
  .message_bar
  nav.nav_bar
    .button.button_regexp(title="正規表現で検索")
    label
      input.searchbox(type="search" placeholder="検索")
      span.hit_count
    .button.button_back.disabled(title="戻る")
    .button.button_forward.disabled(title="進む")
    .button.button_reload(title="再読み込み")
    //- .button.button_bookmark(title="ブックマークする")
    .button.button_write(title="書き込む")
    .button.button_filter(title="レスを絞り込み")
      ul.hidden
        li.filter_all すべて表示
        li.filter_popular 人気レス (3件以上の返信)
        li.filter_image 画像
        li.filter_video 動画
        li.filter_media 画像・動画
        li.filter_link 外部リンク
    //- .button.button_scheme(title="http/httpsの切り替え")
    .button.button_pause(title="自動更新一時停止")
    .thread_info
    ul.breadcrumb: li: a.open_in_rcrx
    .button.button_tool(title="メニュー")
      ul.hidden
        li.button_link: a(target="_blank") ブラウザで直接開く
        li.button_popout 🪟 このスレッドを別窓で開く
        li.button_copy_title_and_url 📋 スレッドのタイトルとURLをコピー
        li.button_copy_url 📋 スレッドのURLをコピー
        li.button_copy_dat_url 📋 スレッドのdatのURLをコピー
        li.button_copy_all 📋 スレッド全文をテキストとしてコピー
        li.button_copy_ng_only 📋 （NGされたレスのみ）スレッド全文をテキストとしてコピー
        li.button_bookmark_add 🔖 スレッドをブックマーク
        li.button_bookmark_remove.hidden 🔖 ブックマークを解除
        li.button_change_netsc 2ch.net/2ch.scに切り替え
        li.button_only_sc scの投稿だけを表示する/両方表示する
        li.button_tool_search_next_thread 🔍 次スレ検索
  .content(tabindex="0")
  .popup_area
  footer.thread_footer
    .loading_indicator.hidden 読み込み中
    a.next_unread.open_in_rcrx.hidden
    button.search_next_thread.hidden 次スレ検索
  //- ul.jump_panel
  //-   li.jump_one >>1
  //-   li.jump_last しおり
  //-   li.jump_not_read 未読
  //-   li.jump_new 新着
  //-   li.jump_latest50 最新50
  //-   li.jump_newest 最後
  .next_thread_list.hidden
    img.close(src=`/img/close_16x16.${image_ext}`)
    h1
      |板内で最も
      span.current
      |と名前の似ているスレッド
    ol
    .status
  .loading_overlay Loading...

block temp
  template#template_res_menu
    menu.res_menu
      li.copy_res 📋 レスをコピー
      li.copy_selection 📋 選択範囲をコピー
      li.copy_id 📋 ID/IPをコピー
      li.copy_slip 📋 SLIPをコピー
      li.copy_trip 📋 トリップをコピー
      li.search_selection 🔎 選択範囲をGoogle検索
      li.search_id_kyodemo 🔎 IDを必死チェッカーで検索
      li.add_id_to_ngwords 🚫 ID/IPをNG指定
      li.add_slip_to_ngwords 🚫 SLIPをNG指定
      li.jump_to_this 📍 このレスまでスクロール
      li.res_to_this ↩️ 返信
      li.res_to_this2 ↩️ 引用して返信
      li.add_writehistory ➕ 書込履歴に追加
      li.del_writehistory ➖ 書込履歴から削除
      li.toggle_aa_mode 
      li.set_image_blur 画像にぼかしをかける
      li.reset_image_blur 画像のぼかしを解除する
      li.res_permalink 🌐 ブラウザで開く
