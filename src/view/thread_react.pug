extends ../_base.pug

block vars
  - var name = "thread_react";
  - var title = "";
  - var html = {};
  - var htmlClasses = ["view", "view_thread"];
  - var body = {};
  - var needUI = true;
  - var needModule = true;
  - var needCss = true;
  - var needCore = true;

block body
  #react-root

block temp
  template#template_res_menu
    menu.res_menu
      li.copy_res 📋 レスをコピー
      li.copy_selection 📋 選択範囲をコピー
      li.copy_id 📋 ID/IPをコピー
      li.copy_slip 📋 SLIPをコピー
      li.copy_trip 📋 トリップをコピー
      li.search_selection 🔎 選択範囲をGoogle検索
      li.add_selection_to_ngwords 🚫 選択範囲をNG指定
      li.search_id_kyodemo 🔎 IDを必死チェッカーで検索
      li.add_id_to_ngwords 🚫 ID/IPをNG指定
      li.add_slip_to_ngwords 🚫 SLIPをNG指定
      li.jump_to_this 📍 このレスまでスクロール
      li.res_to_this ↩️ 返信
      li.res_to_this2 ↩️ 引用して返信
      li.add_writehistory ➕ 書込履歴に追加
      li.del_writehistory ➖ 書込履歴から削除
      li.toggle_aa_mode
      li.set_image_blur 画像にぼかしをかける
      li.reset_image_blur 画像のぼかしを解除する
      li.res_permalink 🌐 ブラウザで開く
