{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "ルールの有効/無効"
      },
      "word": {
        "type": "string",
        "description": "マッチさせる文字列または正規表現"
      },
      "useRegex": {
        "type": "boolean",
        "default": false,
        "description": "正規表現として扱う"
      },
      "type": {
        "type": "string",
        "enum": ["ng", "highlight", "auto"],
        "default": "ng",
        "description": "処理の種類 (ng: 非表示, highlight: 強調, auto: オートNG)"
      },
      "target": {
        "type": "string",
        "enum": ["all", "title", "name", "mail", "id", "slip", "body", "url", "res_count", "reply_count"],
        "default": "all",
        "description": "対象フィールド"
      },
      "scope": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "適用範囲 (ドメイン/板ID)"
      },
      "highlightParams": {
        "type": "object",
        "properties": {
          "bgColor": {
            "type": "string",
            "description": "背景色 (red, blue, #ff0000 等)"
          },
          "label": {
            "type": "string",
            "description": "表示ラベル"
          }
        }
      },
      "expireDate": {
        "type": "string",
        "format": "date",
        "description": "有効期限 (YYYY-MM-DD)"
      },
      "ignoreResNumber": {
        "type": "string",
        "description": "除外レス番号 (例: '1', '1-10')"
      },
      "name": {
        "type": "string",
        "description": "ルールのメモ/名前"
      }
    },
    "required": ["word"]
  }
}
