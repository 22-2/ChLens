{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "read.crx-2",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../debug/tauri",
    "beforeDevCommand": "pnpm run build:tauri",
    "beforeBuildCommand": "pnpm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "read.crx-2",
        "url": "view/browser.html",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
