{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/core/util/map-with-concurrency.ts",
    "src/features/media/ui/external-image-state.ts",
    "packages/chlib/src/url/ChURL.ts",
    "packages/chlib/src/url/patterns.ts",
    "packages/chlib/src/url/storageIdentity.ts",
    "packages/chlib/src/parser/ThreadParser.ts",
    "packages/chlib/src/parser/BoardParser.ts",
    "packages/chlib/src/parser/AnchorParser.ts",
    "packages/chlib/src/parser/MessageParser.ts",
    "packages/chlib/src/fetcher/ThreadFetchPolicy.ts",
    "packages/chlib/src/fetcher/ThreadResponseResolver.ts",
    "src/core/bookmark/read-state-compare.ts",
    "src/core/ng/AutoNgPolicy.ts",
    "src/core/ng/ThreadNgEvaluator.ts",
    "src/features/auto-refresh/browser/auto-refresh-idle-stop.ts",
    "src/features/popup/browser/popup-graph.ts",
    "src/features/popup/browser/popup-position.ts",
    "src/features/thread-list/ui/thread-list-display.ts"
  ],
  "testFiles": [
    "src/core/util/map-with-concurrency.test.ts",
    "src/features/media/ui/external-image-state.test.ts",
    "packages/chlib/src/url/ChURL*.test.ts",
    "packages/chlib/src/url/patterns.test.ts",
    "packages/chlib/src/url/storageIdentity.test.ts",
    "packages/chlib/src/parser/ThreadParser.test.ts",
    "packages/chlib/src/parser/BoardParser.test.ts",
    "packages/chlib/src/parser/AnchorParser.test.ts",
    "packages/chlib/src/parser/MessageParser.test.ts",
    "packages/chlib/src/fetcher/ChFetcher.test.ts",
    "packages/chlib/src/fetcher/ThreadResponseResolver.test.ts",
    "src/core/thread/ThreadParser.test.ts",
    "src/core/thread/ThreadGetHelpers.test.ts",
    "src/core/bookmark/read-state-compare.test.ts",
    "src/core/ng/AutoNgPolicy.test.ts",
    "src/core/ng/ThreadNgEvaluator.test.ts",
    "src/features/auto-refresh/browser/auto-refresh-idle-stop.test.ts",
    "src/features/popup/browser/popup-graph.test.ts",
    "src/features/popup/browser/popup-position.test.ts",
    "src/features/thread-list/ui/thread-list-display.test.ts"
  ],
  "ignorePatterns": ["/coverage", "/debug", "/build"],
  "tsconfigFile": "stryker-unused-tsconfig.json",
  "concurrency": 2,
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "vitest": { "configFile": "vitest.config.ts" }
}
