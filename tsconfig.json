{
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "src/*": ["./src/*"],
      "@chlen/chlib": ["./packages/chlib/src/index.ts"]
    },
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // レガシーJS (jsutil.js 等) が `.ts` 拡張子付きで import しているため許可する。
    // noEmit: true (ビルドは vite が担当) なのでこのオプションは安全に有効化できる。
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "typeRoots": ["src/global.d.ts"],
    "allowJs": true,
    "checkJs": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    // 未使用の引数・継承の override 漏れ・戻り値の取りこぼし・switch の fallthrough を型検査で止める。
    // 未使用の引数は _ で始めて意図的に無視する。
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true
  },
  // `**` は `.` で始まるディレクトリに入らないため、Storybook の設定は明示する。
  // 含めないと型検査（vp check）が paths なしの既定設定で読み、@chlen/chlib を解決できない。
  "include": ["./**/*.ts", "./**/*.tsx", ".storybook/**/*.ts", ".storybook/**/*.tsx"],
  // RustのTauri buildが生成するバイナリ埋め込み用TS断片は、Web側の型検査対象ではない。
  "exclude": ["node_modules", "tests", "src-tauri/**"]
}
