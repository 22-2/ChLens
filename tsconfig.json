{
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "src/*": ["./src/*"],
      "@chlen/ch-lib": ["./packages/ch-lib/src/index.ts"]
    },
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // レガシーJS (jsutil.js 等) が `.ts` 拡張子付きで import しているため許可する。
    // noEmit: true (ビルドは vite が担当) なのでこのオプションは安全に有効化できる。
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "typeRoots": ["src/global.d.ts"],
    "allowJs": true,
    "checkJs": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  // RustのTauri buildが生成するバイナリ埋め込み用TS断片は、Web側の型検査対象ではない。
  "exclude": ["node_modules", "tests", "src-tauri/**"]
}
